# Local web app setup: see docs/LOCAL_DEPLOY.md. Generate stable secrets locally.
ENVIRONMENT=development
JWT_SECRET=
REQUIRE_EMAIL_VERIFICATION=false
SCANNER_DATA_PROVIDER=hybrid
FINNHUB_API_KEY=
RESEARCH_MODEL_PROVIDER=DeepSeek
RESEARCH_MODEL_NAME=deepseek-chat
# Legacy shared host-book jobs are disabled; user Paper accounts are independent.
ENABLE_HOST_PAPER_JOBS=false
# For Ollama, set provider to Ollama and model name to an installed exact tag.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# PostgreSQL for accounts, flows, settings, schedules and SQL reports.
# Use the same password in DATABASE_URL and POSTGRES_PASSWORD.
POSTGRES_DB=market_scanner
POSTGRES_USER=market_scanner
POSTGRES_PASSWORD=replace-with-a-local-random-password
DATABASE_URL=postgresql+psycopg2://market_scanner:replace-with-a-local-random-password@127.0.0.1:5433/market_scanner

# The web app uses user keys saved in Settings, not implicit host paid keys.
# The provider keys below are for legacy CLI / explicit integrations only.
# Financial Datasets is optional; the default hybrid provider uses Yahoo/Finnhub.
# For getting financial data to power the hedge fund
# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# For running LLMs hosted by openai (GPT 5, etc.)
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# For running LLMs hosted by anthropic (claude-4-sonnet, claude-4.1-opus, etc.)
# Get your Anthropic API key from https://anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# For running LLMs hosted by deepseek (deepseek-chat, deepseek-reasoner, etc.)
# Get your DeepSeek API key from https://deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# For running LLMs hosted by groq (deepseek, llama3, etc.)
# Get your Groq API key from https://groq.com/
GROQ_API_KEY=your-groq-api-key

# For running LLMs hosted by gemini (gemini-2.5-flash, gemini-2.5-pro)
# Get your Google API key from https://ai.dev/
GOOGLE_API_KEY=your-google-api-key

# For running LLMs hosted by xAI (Grok 4, etc.)
XAI_API_KEY=your-xai-api-key

# For running LLMs hosted by Moonshot / Kimi (kimi-k2, kimi-latest, moonshot-v1-*)
# Get your Moonshot API key from https://platform.moonshot.ai/
# Mainland China users: set MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=your-moonshot-api-key

# For running LLM GigaChat
GIGACHAT_API_KEY=your-gigachat-api-key

# For running LLMs hosted by OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key

# For running LLMs hosted by Microsoft Azure OpenAI (gpt-4o, gpt-4o-mini, etc.)
# Get your Azure OpenAI API settings from https://oai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
AZURE_OPENAI_DEPLOYMENT_NAME=your-azure-openai-deployment-name

# Notification subscriptions — email delivery via Resend
# Get an API key from https://resend.com → API Keys
# Without a verified sending domain, the default sandbox sender
# (onboarding@resend.dev) can only deliver to the email registered on your
# Resend account. To send to anyone, verify a domain and set RESEND_FROM_EMAIL
# to an address on that domain (e.g. alerts@yourdomain.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Allow notifications to POST to private / loopback URLs (development only).
# Set to "1" if you want to test webhooks against http://127.0.0.1:port endpoints.
NOTIFICATIONS_ALLOW_LOCAL=0

# Encryption key for user API keys at rest (Fernet). REQUIRED for a public
# deploy — without it, users' stored provider keys are written PLAINTEXT to the
# DB (dev-only fallback, logs a warning). Generate once and keep it stable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this value makes existing encrypted rows undecryptable.
APP_ENCRYPTION_KEY=
# Optional MongoDB cache/history. Unset or unavailable => online fallback.
MONGODB_URI=
MONGODB_DATABASE=market_scanner
MONGODB_TIMEOUT_MS=500
MARKET_CACHE_TTL_SECONDS=900
QUOTE_CACHE_TTL_SECONDS=15
LLM_CACHE_TTL_SECONDS=86400
